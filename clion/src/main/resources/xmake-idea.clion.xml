<idea-plugin>
    <dependencies>
        <module name="intellij.platform.dap"/>
        <module name="intellij.clion.toolchains"/>
        <plugin id="com.intellij.modules.clion"/>
        <plugin id="com.intellij.nativeDebug"/>
        <plugin id="com.intellij.clion-compdb"/>
    </dependencies>

    <extensions defaultExtensionNs="io.xmake">
        <debugSupport implementation="io.xmake.clion.ClionDebugSupport"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="io.xmake.clion.compdb.XMakeCompDBAutoLinkActivity"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij.platform.dap">
        <debugAdapterSupportProvider implementation="io.xmake.clion.dap.XMakeDebugAdapterProvider"/>
    </extensions>

    <actions>
        <action id="XMakeProfileSwitcher"
                class="io.xmake.clion.actions.XMakeProfileSwitcherAction">
            <add-to-group group-id="ExecutionTargetsToolbarGroup"/>
            <add-to-group group-id="ToolbarRunGroup" anchor="before" relative-to-action="RunConfiguration"/>
        </action>
    </actions>
</idea-plugin>
