<!-- plugin-docs: https://www.jetbrains.org/intellij/sdk/docs/basics.html -->
<idea-plugin>
    <id>io.xmake</id>
    <name>XMake</name>
    <vendor email="waruqi@gmail.com" url="https://xmake.io">xmake.io</vendor>

    <extensionPoints>
        <extensionPoint name="toolkitHostExtension" interface="io.xmake.utils.extension.ToolkitHostExtension"
                        dynamic="true"/>
    </extensionPoints>

    <!--all-->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.xml</depends>
    <depends>com.intellij.modules.xdebugger</depends>

    <depends optional="true">com.intellij.modules.nativeDebug</depends>

    <!-- Optional so the plugin still loads on IDEA Community; grants the reflective CLion module
         classloader visibility of the Compilation Database classes for IntelliSense integration. -->
    <depends optional="true">com.intellij.clion-compdb</depends>

    <depends optional="true" config-file="io.xmake-ssh.xml">
        com.intellij.modules.ssh
    </depends>
    <!--clion and c/cpp language-->
    <!--
    <depends>com.intellij.clion</depends>
    <depends>com.intellij.modules.cidr.ide</depends>
    <depends>com.intellij.modules.cidr.lang</depends>
    <depends>com.intellij.modules.cidr.modulemap.language</depends>
    <depends>com.intellij.modules.cmake</depends>
    -->

    <extensions defaultExtensionNs="com.intellij">

        <!-- icons -->
        <iconProvider implementation="io.xmake.icons.XMakeIconProvider"/>

        <!-- module-based IDE-->
        <moduleBuilder builderClass="io.xmake.project.wizard.XMakeProjectModuleBuilder"/>
        <!-- directory-based IDE-->
        <directoryProjectGenerator implementation="io.xmake.project.wizard.XMakeProjectDirectoryGenerator"/>

        <!-- xmake toolkit configurations -->
        <projectConfigurable instance="io.xmake.project.XMakeSettingsConfigurable"
                             displayName="Xmake" groupId="build"/>

        <toolWindow id="XMake" anchor="bottom" factoryClass="io.xmake.project.XMakeToolWindowFactory"
                    icon="/icons/xmake-dark.svg"/>

        <!-- run configurations -->
        <programRunner implementation="io.xmake.run.XMakeRunner"/>
        <configurationType implementation="io.xmake.run.XMakeRunConfigurationType"/>
        <runConfigurationProducer implementation="io.xmake.run.XMakeRunConfigurationProducer"/>

        <!-- notifications -->
        <notificationGroup id="XMake.NotificationGroup" displayType="BALLOON"/>

        <postStartupActivity implementation="io.xmake.utils.info.XMakeInfoActivity"/>
        <postStartupActivity implementation="io.xmake.debug.CompDBAutoAttachActivity"/>

        <fileType name="xmake.lua" language="xmake.lua" fieldName="INSTANCE"
                  fileNames="xmake.lua" fileNamesCaseInsensitive="xmake.lua"
                  implementationClass="io.xmake.file.XMakeLuaFileType"/>

        <psi.treeChangeListener implementation="io.xmake.file.XMakeLuaFileChangeListener"/>

        <lang.parserDefinition language="xmake.lua" implementationClass="io.xmake.file.parser.XMakeLuaParserDefinition"/>
        <lang.syntaxHighlighterFactory language="xmake.lua" implementationClass="io.xmake.file.highlight.XMakeLuaSyntaxHighlighterFactory"/>
        <completion.contributor language="xmake.lua" implementationClass="io.xmake.file.completion.XMakeLuaCompletionContributor"/>

    </extensions>

    <!--
    group id
         http://keithlea.com/idea-actions/
         https://github.com/centic9/IntelliJ-Action-IDs
    -->
    <actions>
        <group id="XMake.Menu" class="io.xmake.actions.XMakeMenuGroup" text="Xmake" popup="true" description="XMake menu">
            <add-to-group group-id="MainMenu"
                          anchor="after"
                          relative-to-action="RunMenu"/>
            <action id="XMake.Run"
                    class="io.xmake.actions.RunAction"
                    text="Run Target"
                    icon="AllIcons.Actions.Execute"
                    description="Run the current target."/>
            <action id="XMake.Debug"
                    class="io.xmake.actions.DebugAction"
                    text="Debug Target"
                    icon="AllIcons.Actions.StartDebugger"
                    description="Debug the current target."/>
            <action id="XMake.Build"
                    class="io.xmake.actions.BuildAction"
                    text="Build Project"
                    icon="AllIcons.Actions.Compile"
                    description="Build the current project."/>
            <action id="XMake.Rebuild"
                    class="io.xmake.actions.RebuildAction"
                    text="Rebuild Project"
                    icon="AllIcons.Actions.Restart"
                    description="Rebuild the current project."/>
            <action id="XMake.Clean"
                    class="io.xmake.actions.CleanAction"
                    text="Clean Project"
                    icon="AllIcons.Actions.ClearCash"
                    description="Clean target and object files."/>
            <separator/>
            <reference id="editRunConfigurations"/>
            <action id="XMake.CleanConfiguration"
                    class="io.xmake.actions.CleanConfigurationAction"
                    text="Clean Configuration"
                    icon="AllIcons.Diff.Revert"
                    description="Clean the current configuration."/>
            <separator/>
            <action id="XMake.QuickStart"
                    class="io.xmake.actions.QuickStartAction"
                    text="Quick Start"
                    icon="AllIcons.Actions.Lightning"
                    description="Quick start a new project."/>
            <action id="XMake.UpdateCmakeLists"
                    class="io.xmake.actions.UpdateCmakeListsAction"
                    text="Update CmakeLists"
                    icon="AllIcons.FileTypes.Csv"
                    description="Create or update the CMakeLists.txt.">
                <keyboard-shortcut keymap="$default" first-keystroke="alt U" />
            </action>
            <action id="XMake.UpdateCompileCommands"
                    class="io.xmake.actions.UpdateCompileCommandsAction"
                    text="Update Compile Commands"
                    icon="AllIcons.FileTypes.Json"
                    description="Create or update the compile_commands.json.">
            </action>
        </group>

        <action id="XMake.SelectMode"
                class="io.xmake.actions.selector.XMakeBuildModeAction"
                text="Build Mode"
                description="Select the xmake build mode (release, debug, ...)."/>
        <action id="XMake.SelectTarget"
                class="io.xmake.actions.selector.XMakeTargetAction"
                text="Target"
                description="Select the xmake target to build and run."/>

        <group id="XMake.ToolBar" text="Xmake Toolbar" description="XMake toolbar">
            <reference id="XMake.Run"/>
            <reference id="XMake.Debug"/>
            <reference id="XMake.Build"/>
            <reference id="XMake.Rebuild"/>
            <reference id="XMake.Clean"/>
            <separator/>
            <reference id="editRunConfigurations"/>
            <reference id="XMake.CleanConfiguration"/>
            <separator/>
            <reference id="XMake.UpdateCompileCommands"/>
        </group>

        <!-- Rider-style quick selectors placed in the new-UI run-widget area, just left of the
             run-configuration chip (same anchor JetBrains uses for the execution-target selector). -->
        <group id="XMake.RunWidgetSelectors">
            <reference id="XMake.SelectMode"/>
            <reference id="XMake.SelectTarget"/>
            <add-to-group group-id="MainToolbarRight" anchor="before" relative-to-action="NewUiRunWidget"/>
        </group>

        <!-- Classic-UI fallback: place the same selectors before the run-configuration combo. -->
        <group id="XMake.ClassicToolBarSelectors">
            <reference id="XMake.SelectMode"/>
            <reference id="XMake.SelectTarget"/>
            <separator/>
            <add-to-group group-id="MainToolBar" anchor="before" relative-to-action="RunConfiguration"/>
        </group>
    </actions>

</idea-plugin>
